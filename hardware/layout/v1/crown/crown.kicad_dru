(version 1)
(rule jlcpcb_minimum
  (constraint track_width (min 0.12mm))
  (constraint clearance (min 0.2mm))
  (constraint hole_size (min 0.2mm)))
(rule power_track_width
  (constraint track_width (min 0.22mm))
  (condition "A.hasNetclass('MAIN-Power') || A.hasNetclass('CROWN-Power') || A.hasNetclass('REFLECTOR-Power') || A.hasNetclass('DOME-Power') || A.hasNetclass('PROBE-Power')"))
(rule power_neck_down_at_fine_pitch_pins
  (constraint track_width (min 0.15mm))
  (condition "(A.hasNetclass('MAIN-Power') || A.hasNetclass('CROWN-Power') || A.hasNetclass('REFLECTOR-Power') || A.hasNetclass('DOME-Power') || A.hasNetclass('PROBE-Power')) && (A.intersectsCourtyard('J1') || A.intersectsCourtyard('J2') || A.intersectsCourtyard('J3') || A.intersectsCourtyard('J4') || A.intersectsCourtyard('J5') || A.intersectsCourtyard('J6') || A.intersectsCourtyard('J7') || A.intersectsCourtyard('J8') || A.intersectsCourtyard('J9') || A.intersectsCourtyard('J10') || A.intersectsCourtyard('J11') || A.intersectsCourtyard('U1') || A.intersectsCourtyard('U2') || A.intersectsCourtyard('U3') || A.intersectsCourtyard('U4') || A.intersectsCourtyard('U5') || A.intersectsCourtyard('U6') || A.intersectsCourtyard('U7') || A.intersectsCourtyard('U8') || A.intersectsCourtyard('U9') || A.intersectsCourtyard('U10'))"))
(rule neck_down_at_fine_pitch_pins
  (constraint track_width (min 0.1mm))
  (condition "A.intersectsCourtyard('J1') || A.intersectsCourtyard('J2') || A.intersectsCourtyard('J3') || A.intersectsCourtyard('J4') || A.intersectsCourtyard('J5') || A.intersectsCourtyard('J6') || A.intersectsCourtyard('J7') || A.intersectsCourtyard('J8') || A.intersectsCourtyard('J9') || A.intersectsCourtyard('J10') || A.intersectsCourtyard('J11') || A.intersectsCourtyard('U1') || A.intersectsCourtyard('U2') || A.intersectsCourtyard('U3') || A.intersectsCourtyard('U4') || A.intersectsCourtyard('U5') || A.intersectsCourtyard('U6') || A.intersectsCourtyard('U7') || A.intersectsCourtyard('U8') || A.intersectsCourtyard('U9') || A.intersectsCourtyard('U10')"))
